# Mojang API endpoints
MOJANG_BULK_SERVICES_URL=https://api.minecraftservices.com/minecraft/profile/lookup/bulk/byname
MOJANG_BULK_MOJANG_URL=https://api.mojang.com/minecraft/profile/lookup/bulk/byname
MOJANG_BULK_LEGACY_URL=https://api.mojang.com/profiles/minecraft
MOJANG_AVAILABLE_URL=https://api.minecraftservices.com/minecraft/profile/name/{name}/available

# Bulk lookup (NO AUTH) — Mojang allows ~200/2min per IP
# DO NOT CHANGE THESE NUMBERS IF YOU DON'T KNOW EXACTLY WHAT ARE YOU DOING
RATE_LIMIT_BULK_MAX_REQUESTS=150
RATE_LIMIT_BULK_WINDOW_MS=120000

# Verify auth (/available) — Mojang allows 20/5min per ACCOUNT
# DO NOT CHANGE THESE NUMBERS IF YOU DON'T KNOW EXACTLY WHAT ARE YOU DOING
RATE_LIMIT_VERIFY_MAX_REQUESTS=18
RATE_LIMIT_VERIFY_WINDOW_MS=300000

# Database
DATABASE_PATH=./data/observer.sqlite